; Engine configuration file.
; Bộ Lạc Tiền Sử - Godot 4
config_version=5

[application]
config/name="Bo Lac Tien Su"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[autoload]
CampaignSystem="*res://Scripts/Campaign/CampaignSystem.gd"
TribePopulation="*res://Scripts/Tribe/TribePopulation.gd"
TribeHousingSystem="*res://Scripts/Tribe/TribeHousingSystem.gd"
TribeTrainingSystem="*res://Scripts/Tribe/TribeTrainingSystem.gd"
TribeJobSystem="*res://Scripts/Tribe/TribeJobSystem.gd"
TribeArmySystem="*res://Scripts/Tribe/TribeArmySystem.gd"
RegionSystem="*res://Scripts/World/RegionSystem.gd"
ScoutSystem="*res://Scripts/Tribe/ScoutSystem.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
